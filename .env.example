# Required for database-backed web operation. Supply values outside Git.
DATABASE_URL=
AUTH_SECRET=

# Personal account linking: existing encrypted credentials require their original keys.
# JSON array of {"id":"key-id","key":"32 random bytes encoded as base64"}.
BIWENGER_CREDENTIAL_KEYS=
BIWENGER_CREDENTIAL_ACTIVE_KEY_ID=

# Background ingestion only. Seasons and league bindings live in PostgreSQL.
BIWENGER_TOKEN=

# Optional assistant: choose groq or openai and set its matching key.
AI_PROVIDER=
GROQ_API_KEY=
OPENAI_API_KEY=
AI_MODEL=

# Optional monitoring; server DSN overrides shared public DSN on the server only.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Advanced provider overrides, Docker initialization and maintenance/test controls:
# docs/reference/environment-variables.md
