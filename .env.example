# ==========================================
# DATABASE CONFIGURATION
# ==========================================

# OPTION 1: Local Postgres (Docker) - Default
# To use Local, keep these uncommented and DATABASE_URL commented out.
POSTGRES_HOST=localhost
# POSTGRES_HOST=postgres
# DOCKER_POSTGRES_HOST=remote.db.host
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=biwenger
POSTGRES_PORT=5432

# OPTION 2: Supabase / Remote Postgres
# To use Supabase, uncomment DATABASE_URL and comment out the Local variables above.
# This takes precedence over the individual variables above if set.
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/[DB]"

# ==========================================
# BIWENGER API CREDENTIALS
# ==========================================
# This token is used for background data syncing (market, results, etc.).
# Individual manager tokens for automation (Auto-Align) are stored in the database (users table).
BIWENGER_TOKEN=your_token_here
BIWENGER_LEAGUE_ID=your_league_id_here
BIWENGER_USER_ID=your_user_id_here
# Optional emergency fallback. Normally the API version is auto-detected from /account.
# BIWENGER_API_VERSION_FALLBACK=630

# ==========================================
# CANONICAL SEASON CONFIGURATION
# ==========================================
# Runtime reads and both synchronization sources derive from these values.
SEASON_ID=2026-27
SEASON_NAME="EuroLeague Fantasy 2026-27"
EUROLEAGUE_SEASON_CODE=E2026
# Optional. The free EuroLeague Advanced API endpoints work without it; a bearer token can raise provider limits.
# EUROLEAGUE_ADVANCED_API_TOKEN=your_optional_token
# EUROLEAGUE_ADVANCED_API_URL=https://euroleague-advanced-api.eu
LEAGUE_START_DATE=2026-09-01
SEASON_AWARE_READS_CONFIRMED=false

# ==========================================
# APPLICATION AUTH
# ==========================================
# Random string for session encryption (generate with `openssl rand -base64 32`)
AUTH_SECRET="your_random_secret_string"

# ==========================================
# AI ASSISTANT
# ==========================================
# Server-side only. Used by POST /api/assistant.
AI_PROVIDER="groq"
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-20b"

# Optional alternative provider. Set AI_PROVIDER="openai" to use these values.
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL="gpt-5.4-mini"
