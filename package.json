{
  "name": "biwengerstats-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "docs:check": "prettier --check README.md .agents/INSTRUCTIONS.md \"docs/**/*.md\" && node scripts/dev/check-docs.mjs",
    "format": "prettier --write src/",
    "setup": "node scripts/setup.js",
    "sync": "tsx -r dotenv/config src/lib/sync/index.ts",
    "sync:daily": "tsx -r dotenv/config src/lib/sync/index.ts --daily",
    "sync:live": "tsx -r dotenv/config src/lib/sync/live.ts",
    "sync:preflight": "tsx -r dotenv/config scripts/dev/sync-preflight.ts",
    "sync:playoffs": "tsx -r dotenv/config src/lib/sync/playoffs/sync.ts",
    "test": "vitest",
    "test:run": "vitest --run",
    "db:audit:schema": "tsx -r dotenv/config scripts/dev/audit-schema.ts",
    "db:audit:schema:metadata": "tsx -r dotenv/config scripts/dev/audit-schema.ts --metadata-only",
    "db:season:audit": "tsx -r dotenv/config scripts/dev/audit-seasons.ts",
    "db:season:freeze": "tsx -r dotenv/config scripts/dev/season-lifecycle.ts freeze",
    "db:season:create-next": "tsx -r dotenv/config scripts/dev/season-lifecycle.ts create-next",
    "db:repair:player-prices": "tsx -r dotenv/config scripts/dev/repair-player-prices-from-history.ts",
    "db:check": "tsx scripts/dev/db-check.ts",
    "db:verify": "tsx scripts/dev/verify-db-connection.ts",
    "db:verify:drizzle": "tsx scripts/dev/verify-drizzle.ts",
    "analyze": "ANALYZE=true next build --webpack",
    "simulation:run": "NODE_OPTIONS=--conditions=react-server tsx -r dotenv/config scripts/analysis/run-season-simulations.ts",
    "simulation:merge": "tsx scripts/analysis/merge-season-simulations.ts",
    "simulation:analysis:run": "NODE_OPTIONS=--conditions=react-server tsx -r dotenv/config scripts/analysis/run-season-analysis.ts",
    "simulation:analysis:merge": "tsx scripts/analysis/merge-season-analysis.ts",
    "simulation:analysis:calibrate": "NODE_OPTIONS=--conditions=react-server tsx -r dotenv/config scripts/analysis/calibrate-season-analysis.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@maplibre/maplibre-gl-leaflet": "^0.1.3",
    "@opentelemetry/api": "^1.9.0",
    "@vercel/analytics": "^1.6.1",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "fast-xml-parser": "^5.4.1",
    "framer-motion": "^12.34.3",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.575.0",
    "maplibre-gl": "^5.20.1",
    "next": "^16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "openai": "^6.39.0",
    "pg": "^8.19.0",
    "postgres": "^3.4.8",
    "prompts": "^2.4.2",
    "prop-types": "^15.8.1",
    "react": "^19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.4",
    "react-fast-marquee": "^1.6.5",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.18.0",
    "@types/prompts": "^2.4.9",
    "@types/react": "19.2.14",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10",
    "eslint-config-next": "^16.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
